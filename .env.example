# Copie para .env e defina seus próprios valores (o .env não é versionado).
# Lido pelo Docker Compose (MySQL) e pela aplicação (spring.config.import).

DB_URL=jdbc:mysql://localhost:3306/helpdesk
DB_PORT=3306
DB_USERNAME=helpdesk
DB_PASSWORD=
MYSQL_ROOT_PASSWORD=

# Opcional: porta HTTP da API
# SERVER_PORT=8080

# Opcional: não carregar dados fictícios de desenvolvimento
# FLYWAY_LOCATIONS=classpath:db/migration
